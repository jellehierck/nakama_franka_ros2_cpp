<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nakama_franka_interaction_buttons</name>
  <version>0.0.0</version>
  <description>Nodes to trigger actions based on the HMI Interaction Buttons for Nakama Franka</description>
  <maintainer email="j.j.hierck@student.utwente.nl">Jelle Hierck</maintainer>
  <license>MIT</license>

  <!-- ROS built-in dependencies -->
  <exec_depend>rclpy</exec_depend>
  <depend>example_interfaces</depend>

  <!-- Third-party ROS dependencies -->
  <depend>controller_manager_msgs</depend>

  <!-- First-party ROS dependencies -->
  <depend>bee_buttons_interfaces</depend>
  <depend>nakama_franka_bag</depend>
  <depend>nakama_franka_interfaces</depend>
  <depend>nakama_franka_controllers</depend>

  <!-- Pure python dependencies -->

  <!-- Test dependencies -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
